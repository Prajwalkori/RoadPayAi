# RoadPay AI - Backend Environment Configuration

# Database URL
# Uses local SQLite by default. Change to PostgreSQL for production.
DATABASE_URL=sqlite:///./roadpay.db
# DATABASE_URL=postgresql://user:password@localhost:5432/roadpay

# JWT Secret Key
# Generate a secure random string for signing login tokens
JWT_SECRET_KEY=roadpay-ai-super-secret-key-development-2026

# Local AI Stack Configuration
# Set AI_PROVIDER to 'local' to use YOLO + PaddleOCR + Qwen
AI_PROVIDER=local
LOCAL_LLM_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=smallthinker:latest
YOLO_MODEL_PATH=yolo11n.pt

# SMTP Email Configuration (e.g. Gmail App Passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_gmail_address@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here

# Razorpay Test Mode Keys (UPI, Cards Checkout)
# Get from Razorpay Dashboard settings
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_SECRET=your_razorpay_secret_here
